# ==============================================================================
# REALTIME CHAT DEVOPS - ROOT ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Node Environment: 'development', 'production', 'test'
NODE_ENV=development
PORT=5000

# Backend Identification (In Kubernetes, this is auto-injected via Downward API)
POD_NAME=backend-dev-local

# MongoDB Configuration
# 1) Local Compass: mongodb://127.0.0.1:27017/chat_devops
# 2) Docker Compose: mongodb://mongodb:27017/chat_devops
# 3) Kubernetes:     mongodb://mongodb-service:27017/chat_devops
MONGO_URI=mongodb://mongodb:27017/chat_devops

# Redis Pub/Sub Configuration
# 1) Local host:     127.0.0.1
# 2) Docker Compose: redis
# 3) Kubernetes:     redis-service
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & CORS (allowed origins separated by comma)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Logging Level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Metrics Configuration
PROMETHEUS_METRICS_PATH=/metrics

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_WS_URL=http://localhost:5000
